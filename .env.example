# Optional. The demo runs without any environment variables.
# Protects the /api/cron/* routes when deployed. Vercel Cron sends it as a Bearer token.
CRON_SECRET=
# Which gym this deployment serves: gold, blue or red. Defaults to gold.
TENANT=gold
# Set these once the three Vercel projects exist, so the Nuestras sedes page links to the real addresses.
NEXT_PUBLIC_URL_GOLD=
NEXT_PUBLIC_URL_BLUE=
NEXT_PUBLIC_URL_RED=
